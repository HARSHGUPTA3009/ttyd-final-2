flowchart TB
    classDef model fill:#3b2f0b,stroke:#c9a227,stroke-width:2px,color:#f5e6b8
    classDef safe fill:#0f2a1c,stroke:#2f9e63,stroke-width:1.5px,color:#c8f2da
    classDef http fill:#101f33,stroke:#4c8fd6,stroke-width:1.5px,color:#cfe4f7
    classDef out fill:#1a1d24,stroke:#5a6270,stroke-width:1.5px,color:#e6e6e6
    classDef store fill:#241a2e,stroke:#9a6cd1,stroke-width:1.5px,color:#e8d9f7

    USER([question]):::out

    subgraph HTTP["express middleware — src/middleware.js"]
        direction TB
        A[requestId] --> B[logger] --> C[rateLimit] --> D[validateQuestion] --> E{idempotency<br/><i>same question in flight<br/>or cached?</i>}
    end
    class A,B,C,D,E http

    subgraph PIPE["pipeline — src/pipeline.js"]
        direction TB
        R["retrieve<br/><i>catalog subset</i>"]:::safe
        P["plan<br/><i>the one model call</i><br/>sql | clarify | refuse"]:::model
        PR["probe<br/><i>run rival readings, compare</i>"]:::safe
        V["validate<br/><i>AST guard + column check</i>"]:::safe
        X["execute<br/><i>read-only, row cap</i>"]:::safe
        N["narrate<br/><i>rows only</i>"]:::model
        VF["verify<br/><i>numbers must exist in rows</i>"]:::safe

        R --> P
        P -->|clarify| PR
        P -->|sql| V
        PR -->|agree| V
        V --> X --> N --> VF
    end

    CAT[("catalog.yaml<br/>definitions · pitfalls<br/>missing concepts")]:::store
    DB[("chinook.db<br/><b>readonly</b>")]:::store
    MEM[("cache + history<br/>src/cache.js")]:::store

    ANS([answer + query + rows]):::out
    ASK([clarifying question<br/>+ what each reading returns]):::out
    NO([refusal + what to ask instead]):::out

    USER --> A
    E -->|hit| ANS
    E -->|miss| R

    CAT -.-> P
    CAT -.-> V
    X -.-> DB
    PR -.-> DB

    P -->|refuse| NO
    PR -->|disagree| ASK
    VF --> ANS

    VF -.-> MEM
    MEM -.->|History tab| USER
